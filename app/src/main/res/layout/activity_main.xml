<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/default_gradient">

    <!-- 背景图片层 -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="背景图片"/>

    <!-- 半透明遮罩（当有自定义背景时增加可读性） -->
    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000"
        android:visibility="gone"/>

    <!-- 顶部控制栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 配对按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pair_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🔗 配对设备"
            android:textSize="15sp"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            app:backgroundTint="#6366F1"
            android:paddingHorizontal="28dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- 已连接设备名称 -->
        <LinearLayout
            android:id="@+id/connected_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settings_button">

            <!-- 状态指示器 -->
            <View
                android:id="@+id/status_indicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_disconnected"
                android:layout_marginEnd="10dp"/>

            <!-- 设备名称 -->
            <TextView
                android:id="@+id/device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨️ 设备名"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:layout_marginEnd="8dp"/>

            <!-- 连接状态文字 -->
            <TextView
                android:id="@+id/connection_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已连接"
                android:textColor="@android:color/holo_green_light"
                android:textSize="12sp"
                android:background="@drawable/status_badge_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"/>

        </LinearLayout>

        <!-- 设置按钮 -->
        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#B0FFFFFF"
            android:contentDescription="设置"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 中央输入区域 - 毛玻璃卡片 -->
    <LinearLayout
        android:id="@+id/input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/glass_card_background"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨️ 蓝牙键盘"
            android:textColor="#E0FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="输入文字，发送到已连接的设备"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- 输入框和发送按钮的横向布局 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/input_field_background"
            android:padding="4dp">

            <EditText
                android:id="@+id/input_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="在这里输入文字..."
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minLines="3"
                android:textColor="#FFFFFF"
                android:textColorHint="#70FFFFFF"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.3"
                android:padding="12dp"
                android:imeOptions="actionSend"/>

            <!-- 发送按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/send_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="发送 ➤"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="22dp"
                app:backgroundTint="#10B981"
                android:paddingHorizontal="20dp"
                android:minWidth="80dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- 底部提示 -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="💡 提示：先在系统蓝牙设置中配对目标设备，然后在此连接"
        android:textColor="#60FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
